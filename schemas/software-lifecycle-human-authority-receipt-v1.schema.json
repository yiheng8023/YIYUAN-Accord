{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-autonomy-harness/software-lifecycle-human-authority-receipt-v1.schema.json",
  "title": "Software Lifecycle Human Authority Receipt v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "receiptId",
    "runId",
    "gateId",
    "stageId",
    "sequence",
    "decision",
    "decisionClass",
    "proposalArtifactCanonicalSha256",
    "beforeAcceptedLedgerSha256",
    "allowedChangeIds",
    "rejectedChangeIds",
    "scope",
    "inputArtifactDigests",
    "conditions",
    "issuer",
    "issuedAt",
    "expiresAt",
    "singleUse",
    "simulated",
    "receiptSha256"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "software-lifecycle-human-authority-receipt"
    },
    "receiptId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "runId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "gateId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "stageId": {
      "type": [
        "string",
        "null"
      ]
    },
    "sequence": {
      "type": "integer",
      "minimum": 0
    },
    "decision": {
      "enum": [
        "approve",
        "reject",
        "hold"
      ]
    },
    "decisionClass": {
      "enum": [
        "source-scope",
        "accepted-truth-change",
        "bounded-local-mutation",
        "risk-acceptance",
        "simulated-release",
        "simulated-fault-recovery",
        "maintenance-disposition"
      ]
    },
    "proposalArtifactCanonicalSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "beforeAcceptedLedgerSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "allowedChangeIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "rejectedChangeIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "stageIds",
        "artifactIds",
        "actions"
      ],
      "properties": {
        "stageIds": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "artifactIds": {
          "$ref": "#/$defs/uniqueStrings"
        },
        "actions": {
          "$ref": "#/$defs/uniqueStrings"
        }
      }
    },
    "inputArtifactDigests": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/sha256"
      }
    },
    "conditions": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "issuer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "subjectId",
        "accountableRole",
        "evidenceClass"
      ],
      "properties": {
        "subjectId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "accountableRole": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "evidenceClass": {
          "enum": [
            "parent-captured-human-action",
            "synthetic-calibration-authority"
          ]
        }
      }
    },
    "issuedAt": {
      "type": "string",
      "format": "date-time"
    },
    "expiresAt": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "singleUse": {
      "const": true
    },
    "simulated": {
      "type": "boolean"
    },
    "receiptSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    }
  }
}
