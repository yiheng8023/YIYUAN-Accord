{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "authoritySeriesId", "generation", "predecessorBinding", "programPlanBinding", "assessmentVocabulary", "objectives", "acceptanceCriteria", "verifications", "evidence"],
  "properties": {
    "schema": { "type": "integer", "const": 2 },
    "id": { "type": "string", "minLength": 1 },
    "authoritySeriesId": { "type": "string", "const": "curation-program-acceptance-authority-v2" },
    "generation": { "type": "integer", "minimum": 1 },
    "predecessorBinding": { "$ref": "#/$defs/binding" },
    "programPlanBinding": { "$ref": "#/$defs/binding" },
    "assessmentVocabulary": { "$ref": "#/$defs/assessmentVocabulary" },
    "objectives": { "type": "array", "items": { "$ref": "#/$defs/objective" } },
    "acceptanceCriteria": { "type": "array", "items": { "$ref": "#/$defs/acceptanceCriterion" } },
    "verifications": { "type": "array", "items": { "$ref": "#/$defs/verification" } },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } }
  },
  "$defs": {
    "assessment": { "type": "string", "enum": ["planned", "partial", "verified", "stale", "blocked", "not-applicable"] },
    "assessmentVocabulary": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/assessment" } },
    "stringList": { "type": "array", "items": { "type": "string", "minLength": 1 } },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritySchema", "id", "generation", "path", "sha256"],
      "properties": {
        "authoritySchema": { "type": "integer", "enum": [1, 2] },
        "id": { "type": "string", "minLength": 1 },
        "generation": { "type": ["integer", "null"], "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        { "if": { "properties": { "authoritySchema": { "const": 1 } } }, "then": { "properties": { "generation": { "type": "null" } } } },
        { "if": { "properties": { "authoritySchema": { "const": 2 } } }, "then": { "properties": { "generation": { "type": "integer", "minimum": 1 } } } }
      ]
    },
    "objective": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "acceptanceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "acceptanceIds": { "$ref": "#/$defs/stringList" }
      }
    },
    "graduationSubgate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "requiredEvidence", "promotionBoundary", "status"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "requiredEvidence": { "type": "string", "minLength": 1 },
        "promotionBoundary": { "type": "string", "minLength": 1 },
        "status": { "type": "string", "minLength": 1 }
      }
    },
    "acceptanceCriterion": {
      "oneOf": [
        { "$ref": "#/$defs/basicAcceptanceCriterion" },
        { "$ref": "#/$defs/currentApplicabilityAcceptanceCriterion" },
        { "$ref": "#/$defs/semanticProjectionAcceptanceCriterion" },
        { "$ref": "#/$defs/graduationSubgatesAcceptanceCriterion" }
      ]
    },
    "basicAcceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "assessment", "verificationIds", "evidenceIds"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "verificationIds": { "$ref": "#/$defs/stringList" },
        "evidenceIds": { "$ref": "#/$defs/stringList" }
      }
    },
    "currentApplicabilityAcceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "assessment", "verificationIds", "evidenceIds", "currentApplicability"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "verificationIds": { "$ref": "#/$defs/stringList" },
        "evidenceIds": { "$ref": "#/$defs/stringList" },
        "currentApplicability": { "type": "string", "minLength": 1 }
      }
    },
    "semanticProjectionAcceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "assessment", "verificationIds", "evidenceIds", "semanticProjectionId"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "verificationIds": { "$ref": "#/$defs/stringList" },
        "evidenceIds": { "$ref": "#/$defs/stringList" },
        "semanticProjectionId": { "type": "string", "minLength": 1 }
      }
    },
    "graduationSubgatesAcceptanceCriterion": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "assessment", "verificationIds", "evidenceIds", "graduationSubgates"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "assessment": { "$ref": "#/$defs/assessment" },
        "verificationIds": { "$ref": "#/$defs/stringList" },
        "evidenceIds": { "$ref": "#/$defs/stringList" },
        "graduationSubgates": { "type": "array", "items": { "$ref": "#/$defs/graduationSubgate" } }
      }
    },
    "verification": {
      "oneOf": [
        { "$ref": "#/$defs/verificationWithoutCommand" },
        { "$ref": "#/$defs/verificationWithCommand" }
      ]
    },
    "verificationWithoutCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "evidenceRequirement", "expectedResult"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "evidenceRequirement": { "type": "string", "minLength": 1 },
        "expectedResult": { "type": "string", "minLength": 1 }
      }
    },
    "verificationWithCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "method", "command", "evidenceRequirement", "expectedResult"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "method": { "type": "string", "minLength": 1 },
        "command": { "type": "string", "minLength": 1 },
        "evidenceRequirement": { "type": "string", "minLength": 1 },
        "expectedResult": { "type": "string", "minLength": 1 }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "path", "kind", "asOf", "supports"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "kind": { "type": "string", "minLength": 1 },
        "asOf": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "supports": { "$ref": "#/$defs/stringList" }
      }
    }
  }
}
