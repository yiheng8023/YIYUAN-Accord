{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yiyuan.example/schemas/harness-decision-packet-v2.schema.json",
  "title": "Harness Decision Packet v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "packetId",
    "authorityBinding",
    "request",
    "sourceEvidence",
    "scenarioEvidenceBinding",
    "routeCoverage",
    "fallbackOrder",
    "decisionState",
    "selectedRoute",
    "authorizationGates",
    "claimBoundary",
    "recheckTriggers",
    "projectionBoundary",
    "packetSha256"
  ],
  "properties": {
    "schema": { "const": 2 },
    "packetId": { "type": "string", "minLength": 1 },
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["semanticAuthority", "coverage", "scheduler", "acceptance"],
      "properties": {
        "semanticAuthority": { "$ref": "#/$defs/sourceBinding" },
        "coverage": { "$ref": "#/$defs/sourceBinding" },
        "scheduler": { "$ref": "#/$defs/sourceBinding" },
        "acceptance": { "$ref": "#/$defs/sourceBinding" }
      }
    },
    "request": { "$ref": "harness-decision-request-v1.schema.json" },
    "sourceEvidence": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/sourceEvidence" }
    },
    "scenarioEvidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "registry",
        "scenarioId",
        "sourcePath",
        "bindingMode",
        "identityPointers",
        "resolvedIdentityValues",
        "aggregateScenarioPointer",
        "sourceScenarioId",
        "scenarioIdentityPresentInSource",
        "bindingEvidenceCeiling"
      ],
      "properties": {
        "registry": { "$ref": "#/$defs/sourceBinding" },
        "scenarioId": { "type": "string", "minLength": 1 },
        "sourcePath": { "type": "string", "minLength": 1 },
        "bindingMode": { "enum": ["scenario-record", "document-level-support"] },
        "identityPointers": {
          "type": "array",
          "items": { "type": "string", "pattern": "^/" },
          "uniqueItems": true
        },
        "resolvedIdentityValues": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pointer", "value"],
            "properties": {
              "pointer": { "type": "string", "pattern": "^/" },
              "value": { "type": "string", "minLength": 1 }
            }
          },
          "uniqueItems": true
        },
        "aggregateScenarioPointer": {
          "type": ["string", "null"],
          "minLength": 1
        },
        "sourceScenarioId": { "type": "string", "minLength": 1 },
        "scenarioIdentityPresentInSource": { "type": "boolean" },
        "bindingEvidenceCeiling": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": {
            "properties": { "bindingMode": { "const": "scenario-record" } },
            "required": ["bindingMode"]
          },
          "then": {
            "properties": {
              "identityPointers": { "minItems": 1 },
              "resolvedIdentityValues": { "minItems": 1 },
              "aggregateScenarioPointer": { "const": null },
              "scenarioIdentityPresentInSource": { "const": true }
            }
          }
        },
        {
          "if": {
            "properties": { "bindingMode": { "const": "document-level-support" } },
            "required": ["bindingMode"]
          },
          "then": {
            "properties": {
              "identityPointers": { "maxItems": 0 },
              "resolvedIdentityValues": { "maxItems": 0 },
              "aggregateScenarioPointer": { "type": "string", "minLength": 1 },
              "scenarioIdentityPresentInSource": { "const": false }
            }
          }
        }
      ]
    },
    "routeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["N", "O", "E", "C", "H", "R"],
      "properties": {
        "N": { "$ref": "#/$defs/routeCoverage" },
        "O": { "$ref": "#/$defs/routeCoverage" },
        "E": { "$ref": "#/$defs/routeCoverage" },
        "C": { "$ref": "#/$defs/routeCoverage" },
        "H": { "$ref": "#/$defs/routeCoverage" },
        "R": { "$ref": "#/$defs/routeCoverage" }
      }
    },
    "fallbackOrder": {
      "type": "array",
      "items": { "enum": ["N", "O", "E", "C", "H", "R"] },
      "uniqueItems": true
    },
    "decisionState": { "type": "string", "minLength": 1 },
    "selectedRoute": { "const": null },
    "authorizationGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install", "enable", "connectAccount", "executeCandidate", "dispatchModel",
        "publish", "release", "mutateCcSwitch", "mutateConsumer"
      ],
      "properties": {
        "install": { "const": false },
        "enable": { "const": false },
        "connectAccount": { "const": false },
        "executeCandidate": { "const": false },
        "dispatchModel": { "const": false },
        "publish": { "const": false },
        "release": { "const": false },
        "mutateCcSwitch": { "const": false },
        "mutateConsumer": { "const": false }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructionDeliveryProved", "candidateCausationProved", "liveDomainValueProved",
        "crossHostValueProved", "humanControlExecuted", "residualSelfAuthoredGapProved"
      ],
      "properties": {
        "instructionDeliveryProved": { "const": false },
        "candidateCausationProved": { "const": false },
        "liveDomainValueProved": { "const": false },
        "crossHostValueProved": { "const": false },
        "humanControlExecuted": { "const": false },
        "residualSelfAuthoredGapProved": { "const": false }
      }
    },
    "recheckTriggers": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "projectionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivedProjectionNotAuthority", "legacyRoutingIsCurrentAuthority",
        "portableCoreDependsOnCcSwitch", "pluginReleaseEligible"
      ],
      "properties": {
        "derivedProjectionNotAuthority": { "const": true },
        "legacyRoutingIsCurrentAuthority": { "const": false },
        "portableCoreDependsOnCcSwitch": { "const": false },
        "pluginReleaseEligible": { "const": false }
      }
    },
    "packetSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  },
  "$defs": {
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      }
    },
    "sourceEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path", "id", "sha256", "status", "evidenceCeiling",
        "historicalAuthorityBoundary"
      ],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "id": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "status": { "type": "string", "minLength": 1 },
        "evidenceCeiling": { "type": "string", "minLength": 1 },
        "historicalAuthorityBoundary": { "type": "object" }
      }
    },
    "routeCoverage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "state", "candidateIds", "evidenceCeiling"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "state": { "type": "string", "minLength": 1 },
        "candidateIds": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "evidenceCeiling": { "type": "string", "minLength": 1 }
      }
    }
  }
}
