{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-autonomy-harness/software-lifecycle-accepted-invariant-ledger-v1.schema.json",
  "title": "Software Lifecycle Cumulative Accepted Invariant Ledger v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "ledgerId",
    "runId",
    "protocolCanonicalSha256",
    "sourceRegistryCanonicalSha256",
    "asOfStageId",
    "asOfSequence",
    "previousLedgerSha256",
    "activeInvariants",
    "retiredInvariantIds",
    "transitionHistory",
    "summary",
    "producer",
    "ledgerSha256"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "cumulative-accepted-invariant-ledger"
    },
    "ledgerId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "runId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "protocolCanonicalSha256": {
      "$ref": "#/$defs/sha256"
    },
    "sourceRegistryCanonicalSha256": {
      "$ref": "#/$defs/sha256"
    },
    "asOfStageId": {
      "$ref": "#/$defs/nonEmptyString"
    },
    "asOfSequence": {
      "type": "integer",
      "minimum": 1
    },
    "previousLedgerSha256": {
      "anyOf": [
        {
          "$ref": "#/$defs/sha256"
        },
        {
          "type": "null"
        }
      ]
    },
    "activeInvariants": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/invariant"
      }
    },
    "retiredInvariantIds": {
      "$ref": "#/$defs/uniqueStrings"
    },
    "transitionHistory": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/transition"
      }
    },
    "summary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "activeInvariantCount",
        "retiredInvariantCount",
        "acceptedChangeCount",
        "sourceBackedChangeCount",
        "humanReceiptBackedChangeCount"
      ],
      "properties": {
        "activeInvariantCount": {
          "type": "integer",
          "minimum": 0
        },
        "retiredInvariantCount": {
          "type": "integer",
          "minimum": 0
        },
        "acceptedChangeCount": {
          "type": "integer",
          "minimum": 0
        },
        "sourceBackedChangeCount": {
          "type": "integer",
          "minimum": 0
        },
        "humanReceiptBackedChangeCount": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "producer": {
      "const": "parent-evaluator"
    },
    "ledgerSha256": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "nonEmptyString": {
      "type": "string",
      "minLength": 1
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "uniqueStrings": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/nonEmptyString"
      }
    },
    "basis": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "bindingSha256"
      ],
      "properties": {
        "kind": {
          "enum": [
            "source",
            "human-authority-receipt"
          ]
        },
        "bindingSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    },
    "sourcePointer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifactId",
        "artifactCanonicalSha256",
        "jsonPointer"
      ],
      "properties": {
        "artifactId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "artifactCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "jsonPointer": {
          "type": "string"
        }
      }
    },
    "invariant": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "invariantId",
        "version",
        "status",
        "claim",
        "claimCanonicalSha256",
        "weight",
        "sourcePointers",
        "firstAcceptedSequence",
        "lastChangedSequence",
        "currentAcceptanceBasis"
      ],
      "properties": {
        "invariantId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "version": {
          "type": "integer",
          "minimum": 1
        },
        "status": {
          "const": "active"
        },
        "claim": true,
        "claimCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "weight": {
          "type": "integer",
          "minimum": 1
        },
        "sourcePointers": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sourcePointer"
          }
        },
        "firstAcceptedSequence": {
          "type": "integer",
          "minimum": 1
        },
        "lastChangedSequence": {
          "type": "integer",
          "minimum": 1
        },
        "currentAcceptanceBasis": {
          "$ref": "#/$defs/basis"
        }
      }
    },
    "change": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "changeId",
        "operation",
        "invariantId",
        "beforeVersion",
        "afterVersion",
        "beforeClaimCanonicalSha256",
        "afterClaimCanonicalSha256",
        "basis"
      ],
      "properties": {
        "changeId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "operation": {
          "enum": [
            "add",
            "replace",
            "retire",
            "restore"
          ]
        },
        "invariantId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "beforeVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "afterVersion": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1
        },
        "beforeClaimCanonicalSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "afterClaimCanonicalSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "basis": {
          "$ref": "#/$defs/basis"
        }
      }
    },
    "transition": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "transitionId",
        "stageId",
        "sequence",
        "beforeLedgerSha256",
        "proposalArtifactCanonicalSha256",
        "decision",
        "changes",
        "transitionCanonicalSha256"
      ],
      "properties": {
        "transitionId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "stageId": {
          "$ref": "#/$defs/nonEmptyString"
        },
        "sequence": {
          "type": "integer",
          "minimum": 1
        },
        "beforeLedgerSha256": {
          "anyOf": [
            {
              "$ref": "#/$defs/sha256"
            },
            {
              "type": "null"
            }
          ]
        },
        "proposalArtifactCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        },
        "decision": {
          "enum": [
            "accepted-source-change",
            "accepted-human-authority-change",
            "no-accepted-truth-change"
          ]
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/change"
          }
        },
        "transitionCanonicalSha256": {
          "$ref": "#/$defs/sha256"
        }
      }
    }
  }
}
