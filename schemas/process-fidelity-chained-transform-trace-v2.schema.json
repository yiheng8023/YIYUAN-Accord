{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-autonomy-harness/process-fidelity-chained-transform-trace-v2.schema.json",
  "title": "Process Fidelity Chained Transform Evaluated Trace v2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "eligibility",
    "execution",
    "runIdentity",
    "materialEdges",
    "hopMetrics",
    "injectionLedger",
    "recoveryLedger",
    "absoluteLedger",
    "processLedger",
    "rawArtifactIndex",
    "manualMetricSupplementationUsed",
    "claimBoundary"
  ],
  "properties": {
    "schema": {
      "const": 2
    },
    "kind": {
      "const": "process-fidelity-chained-transform-evaluated-trace"
    },
    "eligibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "failureCodes",
        "formalLiveEvidenceEligible"
      ],
      "properties": {
        "status": {
          "enum": [
            "live-valid",
            "calibration-only",
            "invalid",
            "opaque"
          ]
        },
        "failureCodes": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "uniqueItems": true
        },
        "formalLiveEvidenceEligible": {
          "type": "boolean"
        }
      }
    },
    "execution": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "agentDispatchCount",
        "modelCallCount",
        "actualRouteObserved",
        "requestedRouteCountsAsObservedRoute"
      ],
      "properties": {
        "agentDispatchCount": {
          "type": "integer",
          "minimum": 0
        },
        "modelCallCount": {
          "type": "integer",
          "minimum": 0
        },
        "actualRouteObserved": {
          "type": "boolean"
        },
        "requestedRouteCountsAsObservedRoute": {
          "const": false
        }
      }
    },
    "runIdentity": {
      "type": "object"
    },
    "materialEdges": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5
    },
    "hopMetrics": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3
    },
    "injectionLedger": {
      "type": "object"
    },
    "recoveryLedger": {
      "type": "object"
    },
    "absoluteLedger": {
      "type": "object"
    },
    "processLedger": {
      "type": "object"
    },
    "rawArtifactIndex": {
      "type": "array",
      "minItems": 1
    },
    "manualMetricSupplementationUsed": {
      "const": false
    },
    "claimBoundary": {
      "type": "object"
    }
  }
}
