{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "authoritySeriesId", "transactionType", "fromSnapshotBinding", "toSnapshotBinding", "fromProgramPlanBinding", "toProgramPlanBinding", "delta", "invariants", "authorizationBoundary", "executionCounters", "claimBoundary"],
  "properties": {
    "schema": { "type": "integer", "const": 1 },
    "id": { "type": "string", "minLength": 1 },
    "authoritySeriesId": { "type": "string", "const": "curation-program-acceptance-authority-v2" },
    "transactionType": { "type": "string", "enum": ["structural-migration", "evidence-registration", "assessment-transition", "rollback"] },
    "fromSnapshotBinding": { "$ref": "#/$defs/binding" },
    "toSnapshotBinding": { "$ref": "#/$defs/binding" },
    "fromProgramPlanBinding": { "$ref": "#/$defs/binding" },
    "toProgramPlanBinding": { "$ref": "#/$defs/binding" },
    "delta": { "$ref": "#/$defs/delta" },
    "invariants": { "$ref": "#/$defs/invariants" },
    "authorizationBoundary": { "$ref": "#/$defs/authorizationBoundary" },
    "executionCounters": { "$ref": "#/$defs/zeroExecutionCounters" },
    "claimBoundary": { "$ref": "#/$defs/claimBoundary" }
  },
  "$defs": {
    "assessment": { "type": "string", "enum": ["planned", "partial", "verified", "stale", "blocked", "not-applicable"] },
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritySchema", "id", "generation", "path", "sha256"],
      "properties": {
        "authoritySchema": { "type": "integer", "enum": [1, 2] },
        "id": { "type": "string", "minLength": 1 },
        "generation": { "type": ["integer", "null"], "minimum": 1 },
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
      },
      "allOf": [
        { "if": { "properties": { "authoritySchema": { "const": 1 } } }, "then": { "properties": { "generation": { "type": "null" } } } },
        { "if": { "properties": { "authoritySchema": { "const": 2 } } }, "then": { "properties": { "generation": { "type": "integer", "minimum": 1 } } } }
      ]
    },
    "criterionEvidenceLink": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "evidenceId"],
      "properties": {
        "criterionId": { "type": "string", "minLength": 1 },
        "evidenceId": { "type": "string", "minLength": 1 }
      }
    },
    "assessmentChange": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criterionId", "fromAssessment", "toAssessment"],
      "properties": {
        "criterionId": { "type": "string", "minLength": 1 },
        "fromAssessment": { "$ref": "#/$defs/assessment" },
        "toAssessment": { "$ref": "#/$defs/assessment" }
      }
    },
    "delta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidenceAdded", "evidenceRemoved", "criterionEvidenceLinksAdded", "criterionEvidenceLinksRemoved", "assessmentsChanged", "selectorTargetGeneration"],
      "properties": {
        "evidenceAdded": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "evidenceRemoved": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "criterionEvidenceLinksAdded": { "type": "array", "items": { "$ref": "#/$defs/criterionEvidenceLink" } },
        "criterionEvidenceLinksRemoved": { "type": "array", "items": { "$ref": "#/$defs/criterionEvidenceLink" } },
        "assessmentsChanged": { "type": "array", "items": { "$ref": "#/$defs/assessmentChange" } },
        "selectorTargetGeneration": { "type": ["integer", "null"], "minimum": 1 }
      }
    },
    "invariants": {
      "type": "object",
      "additionalProperties": false,
      "required": ["authoritySeriesPreserved", "generationStepValid", "immutableHistoryPreserved", "programPlanBindingsValid", "acceptanceInventory"],
      "properties": {
        "authoritySeriesPreserved": { "type": "boolean", "const": true },
        "generationStepValid": { "type": "boolean", "const": true },
        "immutableHistoryPreserved": { "type": "boolean", "const": true },
        "programPlanBindingsValid": { "type": "boolean", "const": true },
        "acceptanceInventory": { "$ref": "#/$defs/acceptanceInventory" }
      }
    },
    "acceptanceInventory": {
      "type": "object",
      "additionalProperties": false,
      "required": ["verified", "partial", "planned"],
      "properties": {
        "verified": { "type": "integer", "minimum": 0 },
        "partial": { "type": "integer", "minimum": 0 },
        "planned": { "type": "integer", "minimum": 0 }
      }
    },
    "authorizationBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["rehearsalAuthorized", "liveMigrationAuthorized", "assessmentTransitionAuthorized", "productionActivationAuthorized"],
      "properties": {
        "rehearsalAuthorized": { "type": "boolean", "const": true },
        "liveMigrationAuthorized": { "type": "boolean", "const": false },
        "assessmentTransitionAuthorized": { "type": "boolean", "const": false },
        "productionActivationAuthorized": { "type": "boolean", "const": false }
      }
    },
    "zeroExecutionCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["modelRequestCount", "candidateExecutionCount", "pluginExecutionCount", "installCount", "enableCount", "accountConnectionCount", "managerMutationCount", "consumerMutationCount", "publicationCount", "releaseCount", "productionActivationCount"],
      "properties": {
        "modelRequestCount": { "type": "integer", "const": 0 },
        "candidateExecutionCount": { "type": "integer", "const": 0 },
        "pluginExecutionCount": { "type": "integer", "const": 0 },
        "installCount": { "type": "integer", "const": 0 },
        "enableCount": { "type": "integer", "const": 0 },
        "accountConnectionCount": { "type": "integer", "const": 0 },
        "managerMutationCount": { "type": "integer", "const": 0 },
        "consumerMutationCount": { "type": "integer", "const": 0 },
        "publicationCount": { "type": "integer", "const": 0 },
        "releaseCount": { "type": "integer", "const": 0 },
        "productionActivationCount": { "type": "integer", "const": 0 }
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["provesBehavior", "provesValue", "provesCrossHostPortability", "provesProductionReadiness", "provesReleaseEligibility", "provesOverallHarnessCompletion"],
      "properties": {
        "provesBehavior": { "type": "boolean", "const": false },
        "provesValue": { "type": "boolean", "const": false },
        "provesCrossHostPortability": { "type": "boolean", "const": false },
        "provesProductionReadiness": { "type": "boolean", "const": false },
        "provesReleaseEligibility": { "type": "boolean", "const": false },
        "provesOverallHarnessCompletion": { "type": "boolean", "const": false }
      }
    }
  }
}
