{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yiyuan.example/schemas/harness-decision-packet-manifest-v1.schema.json",
  "title": "Harness Decision Packet Thirteen-Scenario Manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema", "id", "packetSchema", "authorityBinding", "atomic",
    "scenarioCount", "entries", "executionCounters", "authorizationGates",
    "claimBoundary", "projectionBoundary", "manifestSha256"
  ],
  "properties": {
    "schema": {"const": 1},
    "id": {"const": "harness-decision-packet-thirteen-scenario-manifest-v1"},
    "packetSchema": {"const": 2},
    "authorityBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "semanticAuthority", "coverage", "scheduler", "acceptance",
        "bindingRegistry"
      ],
      "properties": {
        "semanticAuthority": {"$ref": "#/$defs/sourceBinding"},
        "coverage": {"$ref": "#/$defs/sourceBinding"},
        "scheduler": {"$ref": "#/$defs/sourceBinding"},
        "acceptance": {"$ref": "#/$defs/sourceBinding"},
        "bindingRegistry": {"$ref": "#/$defs/sourceBinding"}
      }
    },
    "atomic": {"const": true},
    "scenarioCount": {"const": 13},
    "entries": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/manifestEntry"}
    },
    "executionCounters": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "modelRequestCount", "candidateExecutionCount", "pluginExecutionCount",
        "managerMutationCount", "accountConnectionCount", "consumerMutationCount",
        "installationCount", "enablementCount", "publicationCount"
      ],
      "properties": {
        "modelRequestCount": {"const": 0},
        "candidateExecutionCount": {"const": 0},
        "pluginExecutionCount": {"const": 0},
        "managerMutationCount": {"const": 0},
        "accountConnectionCount": {"const": 0},
        "consumerMutationCount": {"const": 0},
        "installationCount": {"const": 0},
        "enablementCount": {"const": 0},
        "publicationCount": {"const": 0}
      }
    },
    "authorizationGates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "install", "enable", "connectAccount", "executeCandidate", "dispatchModel",
        "publish", "release", "mutateCcSwitch", "mutateConsumer"
      ],
      "properties": {
        "install": {"const": false},
        "enable": {"const": false},
        "connectAccount": {"const": false},
        "executeCandidate": {"const": false},
        "dispatchModel": {"const": false},
        "publish": {"const": false},
        "release": {"const": false},
        "mutateCcSwitch": {"const": false},
        "mutateConsumer": {"const": false}
      }
    },
    "claimBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instructionDeliveryProved", "candidateCausationProved", "liveDomainValueProved",
        "crossHostValueProved", "humanControlExecuted", "residualSelfAuthoredGapProved"
      ],
      "properties": {
        "instructionDeliveryProved": {"const": false},
        "candidateCausationProved": {"const": false},
        "liveDomainValueProved": {"const": false},
        "crossHostValueProved": {"const": false},
        "humanControlExecuted": {"const": false},
        "residualSelfAuthoredGapProved": {"const": false}
      }
    },
    "projectionBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "derivedProjectionNotAuthority", "legacyRoutingIsCurrentAuthority",
        "portableCoreDependsOnCcSwitch", "pluginReleaseEligible"
      ],
      "properties": {
        "derivedProjectionNotAuthority": {"const": true},
        "legacyRoutingIsCurrentAuthority": {"const": false},
        "portableCoreDependsOnCcSwitch": {"const": false},
        "pluginReleaseEligible": {"const": false}
      }
    },
    "manifestSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "$defs": {
    "sourceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "manifestEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId", "bindingMode", "sourcePath", "sourceSha256",
        "packetSha256", "decisionState", "selectedRoute", "bindingEvidenceCeiling"
      ],
      "properties": {
        "scenarioId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
        "bindingMode": {"enum": ["scenario-record", "document-level-support"]},
        "sourcePath": {"type": "string", "minLength": 1},
        "sourceSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "packetSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "decisionState": {"const": "mechanism-evidence-only"},
        "selectedRoute": {"const": null},
        "bindingEvidenceCeiling": {"type": "string", "minLength": 1}
      }
    }
  }
}
