{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-autonomy-harness.local/schemas/harness-scenario-evidence-binding-registry-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "id", "date", "status", "coverageAuthority", "bindings"],
  "properties": {
    "schema": {"const": 1},
    "id": {"const": "harness-scenario-evidence-bindings-v1"},
    "date": {"type": "string", "format": "date"},
    "status": {"type": "string", "minLength": 1},
    "coverageAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "id", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "id": {"type": "string", "minLength": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "bindings": {
      "type": "array",
      "minItems": 13,
      "maxItems": 13,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "$defs": {
    "binding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "scenarioId", "sourcePath", "bindingMode", "identityPointers",
        "aggregateScenarioPointer", "expectedAggregateScenarioId",
        "scenarioIdentityPresentInSource", "bindingEvidenceCeiling", "explanation"
      ],
      "properties": {
        "scenarioId": {"type": "string", "pattern": "^[A-Z][A-Z0-9-]*$"},
        "sourcePath": {"type": "string", "minLength": 1},
        "bindingMode": {"enum": ["scenario-record", "document-level-support"]},
        "identityPointers": {
          "type": "array",
          "items": {"type": "string", "pattern": "^/"},
          "uniqueItems": true
        },
        "aggregateScenarioPointer": {"type": ["string", "null"]},
        "expectedAggregateScenarioId": {"type": ["string", "null"]},
        "scenarioIdentityPresentInSource": {"type": "boolean"},
        "bindingEvidenceCeiling": {"type": "string", "minLength": 1},
        "explanation": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {
          "if": {"properties": {"bindingMode": {"const": "scenario-record"}}},
          "then": {
            "properties": {
              "identityPointers": {"minItems": 1},
              "aggregateScenarioPointer": {"type": "null"},
              "expectedAggregateScenarioId": {"type": "null"},
              "scenarioIdentityPresentInSource": {"const": true}
            }
          }
        },
        {
          "if": {"properties": {"bindingMode": {"const": "document-level-support"}}},
          "then": {
            "properties": {
              "identityPointers": {"maxItems": 0},
              "aggregateScenarioPointer": {"type": "string", "minLength": 1},
              "expectedAggregateScenarioId": {"type": "string", "minLength": 1},
              "scenarioIdentityPresentInSource": {"const": false}
            }
          }
        }
      ]
    }
  }
}
