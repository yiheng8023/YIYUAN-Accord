{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yiyuan.example/schemas/harness-decision-request-v1.schema.json",
  "title": "Harness Decision Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "requestId",
    "scenarioId",
    "evidenceLane",
    "expectedSemanticAuthorityId",
    "observedAvailability",
    "taskBinding",
    "currentCapabilityGap",
    "activationAuthority"
  ],
  "properties": {
    "schema": { "const": 1 },
    "requestId": { "type": "string", "minLength": 1 },
    "scenarioId": { "type": "string", "pattern": "^[A-Z][A-Z0-9-]*$" },
    "evidenceLane": {
      "enum": ["portfolio-curation", "mechanism-validation", "task-time"]
    },
    "expectedSemanticAuthorityId": { "type": "string", "minLength": 1 },
    "observedAvailability": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/observedAvailability" }
      ]
    },
    "taskBinding": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/taskBinding" }
      ]
    },
    "currentCapabilityGap": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/currentCapabilityGap" }
      ]
    },
    "activationAuthority": {
      "anyOf": [
        { "type": "null" },
        { "$ref": "#/$defs/activationAuthority" }
      ]
    }
  },
  "$defs": {
    "nonEmptyString": { "type": "string", "minLength": 1 },
    "stringList": {
      "type": "array",
      "items": { "$ref": "#/$defs/nonEmptyString" },
      "minItems": 1,
      "uniqueItems": true
    },
    "observedAvailability": {
      "type": "object",
      "additionalProperties": false,
      "required": ["asOf", "host", "availableRouteClasses", "evidencePaths"],
      "properties": {
        "asOf": { "$ref": "#/$defs/nonEmptyString" },
        "host": { "$ref": "#/$defs/nonEmptyString" },
        "availableRouteClasses": {
          "type": "array",
          "items": { "enum": ["N", "O", "E", "C", "H", "R"] },
          "uniqueItems": true
        },
        "evidencePaths": { "$ref": "#/$defs/stringList" }
      }
    },
    "taskBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["taskId", "goal", "target", "verificationSurface"],
      "properties": {
        "taskId": { "$ref": "#/$defs/nonEmptyString" },
        "goal": { "$ref": "#/$defs/nonEmptyString" },
        "target": { "$ref": "#/$defs/nonEmptyString" },
        "verificationSurface": { "$ref": "#/$defs/nonEmptyString" }
      }
    },
    "currentCapabilityGap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requiredCapability", "observedLimitation", "evidencePaths"],
      "properties": {
        "requiredCapability": { "$ref": "#/$defs/nonEmptyString" },
        "observedLimitation": { "$ref": "#/$defs/nonEmptyString" },
        "evidencePaths": { "$ref": "#/$defs/stringList" }
      }
    },
    "activationAuthority": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidencePath", "scope"],
      "properties": {
        "evidencePath": { "$ref": "#/$defs/nonEmptyString" },
        "scope": { "$ref": "#/$defs/nonEmptyString" }
      }
    }
  }
}
