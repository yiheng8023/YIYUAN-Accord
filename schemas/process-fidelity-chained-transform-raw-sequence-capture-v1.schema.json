{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/agent-autonomy-harness/process-fidelity-chained-transform-raw-sequence-capture-v1.schema.json",
  "title": "Process Fidelity Chained Transform Raw Sequence Capture v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "kind",
    "mode",
    "bindings",
    "execution",
    "cell",
    "stageReceipts",
    "parentTransformReceipts",
    "materialEdges",
    "rawArtifactIndex",
    "completion",
    "eligibleForFormalLiveEvidence"
  ],
  "properties": {
    "schema": {
      "const": 1
    },
    "kind": {
      "const": "chained-transform-raw-sequence-capture"
    },
    "mode": {
      "const": "zero-model-scripted-order-calibration"
    },
    "bindings": {
      "type": "object"
    },
    "execution": {
      "type": "object"
    },
    "cell": {
      "type": "object"
    },
    "stageReceipts": {
      "type": "array",
      "maxItems": 3
    },
    "parentTransformReceipts": {
      "type": "array",
      "maxItems": 2
    },
    "materialEdges": {
      "type": "array",
      "maxItems": 5
    },
    "rawArtifactIndex": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "artifactId",
          "path",
          "bytes",
          "rawSha256",
          "canonicalSha256",
          "repositoryLocalAuditPath"
        ],
        "properties": {
          "artifactId": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "bytes": {
            "type": "integer",
            "minimum": 1
          },
          "rawSha256": {
            "$ref": "#/$defs/sha256"
          },
          "canonicalSha256": {
            "$ref": "#/$defs/sha256"
          },
          "repositoryLocalAuditPath": {
            "type": "boolean"
          }
        }
      }
    },
    "completion": {
      "type": "object"
    },
    "eligibleForFormalLiveEvidence": {
      "const": false
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[A-Fa-f0-9]{64}$"
    }
  }
}
