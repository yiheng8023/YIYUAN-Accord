  "reviewAxes": [
    {
      "id": "spec-and-repository-standards",
      "question": "Do the frozen artifacts implement the stated product, research, and report contracts without scope creep or repository-rule violations?"
    },
    {
      "id": "source-rights-and-bounded-use",
      "question": "Are ISO and other source rights, retention, quotation, metadata-only, and permitted-use boundaries correctly classified and preserved?"
    },
    {
      "id": "source-identity-evidence-strength-and-freshness",
      "question": "Do identity, revision, archive, digest, freshness, reachability, and model-mediated observation claims stay within the evidence actually retained?"
    },
    {
      "id": "conflict-ambiguity-and-counterevidence",
      "question": "Are mutable, partially observed, disputed, conflicting, and portability findings visible without being silently resolved or cancelled?"
    },
    {
      "id": "dimension-floor-and-profile-judgments",
      "question": "Are dimensions, profile axes, evidence grades, assessment labels, candidate-floor results, and next evidence proportionate to each frozen target?"
    },
    {
      "id": "plural-subject-and-anti-deference-boundary",
      "question": "Does the package separate user preference and authorization from fact, general-population validity, affected-subject impact, dissent, and accountable acceptance?"
    },
    {
      "id": "claim-authority-and-acceptance-boundary",
      "question": "Do self-assessment, independent review, acceptance, hard-standard promotion, Skill necessity, release readiness, and broad validity remain separate?"
    },
    {
      "id": "provenance-portability-and-line-ending-semantics",
      "question": "Are Git-object bindings reproducible, and is the Windows-CRLF runtime-byte versus Git-LF durable-byte finding classified without hiding or overgeneralizing it?"
    },
    {
      "id": "deterministic-reproduction-and-negative-controls",
      "question": "Can the bound builders and validators be independently rerun, and do their negative controls reject material identity, rights, evidence, authority, and manifest drift?"
    },
    {
      "id": "capability-reuse-and-residual-gap-boundary",
      "question": "Does the package reuse native, official, reviewed external, and composed review capabilities without treating this packet, a review Skill, or current gaps as proof that a new Skill is necessary?"
    }
  ],
