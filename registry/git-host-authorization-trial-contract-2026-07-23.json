{
  "schema": 1,
  "id": "git-host-authorization-trial-contract-2026-07-23",
  "date": "2026-07-23",
  "status": "verified-local-authorization-contract-live-user-repository-trial-pending",
  "reuse": {
    "snapshot": "scripts/observe_git_snapshot.py",
    "decisionEvaluator": "scripts/evaluate_git_topology_trial.py",
    "fixtures": "tests/fixtures/git-topology-decision-fixtures-2026-07-19.json",
    "weakAgentScenario": "ABL-GIT-TOPOLOGY-01",
    "newGitManagerAuthorized": false,
    "gitGuardrailsHookSubstitutesForTopologyJudgment": false
  },
  "phases": [
    {
      "id": "preflight",
      "mutationAuthorized": false,
      "requiredEvidence": [
        "absolute repository and worktree path",
        "complete read-only Git snapshot",
        "exact dirty-path ownership",
        "task type and dependency on current dirty state"
      ],
      "stopWhen": [
        "dirty ownership unknown",
        "snapshot incomplete",
        "task or target unbound"
      ]
    },
    {
      "id": "create",
      "requiresSeparateAuthorization": true,
      "requiredEvidence": [
        "target topology",
        "exact base SHA",
        "branch name",
        "absolute worktree path when applicable",
        "target-path collision check",
        "native host approval result"
      ],
      "onFailure": "reobserve-only-no-automatic-retry-or-cleanup"
    },
    {
      "id": "merge",
      "requiresSeparateAuthorization": true,
      "authorizationInheritedFromCreate": false,
      "allowedStrategy": "ff-only",
      "requiredEvidence": [
        "source and target SHA",
        "clean source and target",
        "verification record",
        "fast-forward reachability",
        "native host approval result"
      ],
      "onFailure": "stop-for-human-decision-no-rebase-or-conflict-resolution"
    },
    {
      "id": "cleanup",
      "requiresSeparateAuthorization": true,
      "authorizationInheritedFromCreateOrMerge": false,
      "allowedOperations": [
        "non-force worktree remove",
        "safe merged branch delete"
      ],
      "requiredEvidence": [
        "exact object list",
        "delivered or explicitly disposable state",
        "clean worktree",
        "merged branch",
        "commit reachability after cleanup"
      ],
      "onFailure": "retain-all-targets-no-force-remove-delete-or-prune"
    },
    {
      "id": "recovery",
      "mutationAuthorizedByFailureAlone": false,
      "requiredEvidence": [
        "before and after Git snapshot",
        "refs, worktree, dirty bytes, path and process ownership"
      ],
      "statusVocabulary": [
        "unchanged",
        "reconstructable-state-observed",
        "recovery-write-needs-authorization",
        "unknown"
      ]
    }
  ],
  "forbiddenAutomation": [
    "automatic stash",
    "reset",
    "restore",
    "rebase",
    "conflict resolution",
    "force worktree removal",
    "force branch deletion",
    "broad prune",
    "remote mutation"
  ],
  "claimBoundary": {
    "boundUserRepositoryCreateSafetyProved": false,
    "hostApprovalDenialBehaviorProved": false,
    "boundUserRepositoryMergeOrCleanupProved": false,
    "crashInterruptionOrConcurrentRecoveryProved": false,
    "remoteFreshnessOrCiProved": false,
    "crossHostParityProved": false,
    "weakAgentLiveJudgmentProved": false
  },
  "nextGate": "separately-authorized-bound-repository-create-or-denial-trial-with-before-after-snapshot-and-no-inherited-merge-or-cleanup-authority"
}
