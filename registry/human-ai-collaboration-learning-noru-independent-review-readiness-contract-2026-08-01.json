  "reviewAxes": [
    {
      "id": "content-and-answer-key-correctness",
      "question": "Are every Noru rule, worked example, practice item, assessment answer, scoring boundary, and executable oracle case correct and internally consistent?"
    },
    {
      "id": "immediate-delayed-form-balance",
      "question": "Are the immediate and delayed forms comparable enough for the intended bounded use, with the known wrap-versus-advance difference and any additional asymmetry explicitly reported rather than called equivalent?"
    },
    {
      "id": "misconception-coverage-and-falsifiers",
      "question": "Do misconception labels cover material wrong-reasoning classes without confusing accessibility barriers, wording ambiguity, or delivery style with domain misunderstanding?"
    },
    {
      "id": "readability-and-instruction-clarity",
      "question": "Can a learner understand the glossary, rules, examples, practice instructions, response format, and allowed help without private-oracle knowledge or unstated assumptions?"
    },
    {
      "id": "accessibility-and-accommodation-boundary",
      "question": "Does the text-only packet support linear reading and the declared accommodations, while keeping accessibility in use and screen-reader behavior unproved until actually reviewed?"
    },
    {
      "id": "public-private-oracle-isolation",
      "question": "Are assessment answers, scoring, misconception labels, and private identifiers absent from every learner or tutor surface and protected from accidental inclusion?"
    },
    {
      "id": "cleanup-data-and-participant-safety-boundary",
      "question": "Are the exact disposable root, before/after manifests, forbidden data, retention decision, participant-contact prohibition, and later consent/privacy/withdrawal/safeguarding gates complete and fail-closed?"
    },
    {
      "id": "claim-authority-and-live-readiness",
      "question": "Do structural calibration, independent review, participant safeguards, form equivalence, learning effect, candidate value, live readiness, acceptance, and release remain distinct?"
    },
    {
      "id": "deterministic-reproduction-and-negative-controls",
      "question": "Can the frozen validator be rerun from exact Git objects, and do negative controls reject answer leakage, oracle drift, item overlap, unresolved misconceptions, form-equivalence promotion, cleanup broadening, and usability-claim promotion?"
    },
    {
      "id": "capability-reuse-and-residual-gap-boundary",
      "question": "Does the package preserve the native, official, reviewed-external, and human-control comparison without treating the packet, review workflow, missing live evidence, or reviewer preference as proof that a Skill or hard standard is needed?"
    }
  ],
