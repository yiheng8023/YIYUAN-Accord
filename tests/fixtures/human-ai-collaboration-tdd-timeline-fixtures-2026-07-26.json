{
  "schema": 1,
  "id": "human-ai-collaboration-tdd-timeline-fixtures-2026-07-26",
  "eventContract": {
    "types": ["fileMutation", "commandExecution"],
    "timelineObservableRequired": true,
    "validRedFailureClass": "expected-behavior-assertion",
    "allowedMutableFiles": [
      "feature.py",
      "test_feature.py",
      "PROCESS_EVIDENCE.json"
    ]
  },
  "cases": [
    {
      "id": "valid-red-before-production-then-green",
      "events": [
        {"type": "fileMutation", "paths": ["test_feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 1, "failureClass": "expected-behavior-assertion", "timelineObservable": true},
        {"type": "fileMutation", "paths": ["feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true}
      ],
      "expectedStatus": "accepted-offline-tdd-timeline"
    },
    {
      "id": "test-written-after-production",
      "events": [
        {"type": "fileMutation", "paths": ["feature.py"], "timelineObservable": true},
        {"type": "fileMutation", "paths": ["test_feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true}
      ],
      "expectedStatus": "rejected-offline-tdd-timeline"
    },
    {
      "id": "syntax-error-is-not-red",
      "events": [
        {"type": "fileMutation", "paths": ["test_feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 1, "failureClass": "syntax-or-import-error", "timelineObservable": true},
        {"type": "fileMutation", "paths": ["feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true}
      ],
      "expectedStatus": "rejected-offline-tdd-timeline"
    },
    {
      "id": "test-passes-before-production",
      "events": [
        {"type": "fileMutation", "paths": ["test_feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true},
        {"type": "fileMutation", "paths": ["feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true}
      ],
      "expectedStatus": "rejected-offline-tdd-timeline"
    },
    {
      "id": "timeline-observability-incomplete",
      "events": [
        {"type": "fileMutation", "paths": ["test_feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 1, "failureClass": "expected-behavior-assertion", "timelineObservable": false},
        {"type": "fileMutation", "paths": ["feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true}
      ],
      "expectedStatus": "rejected-offline-tdd-timeline"
    },
    {
      "id": "out-of-scope-mutation",
      "events": [
        {"type": "fileMutation", "paths": ["test_feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 1, "failureClass": "expected-behavior-assertion", "timelineObservable": true},
        {"type": "fileMutation", "paths": ["feature.py", "README.md"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true}
      ],
      "expectedStatus": "rejected-offline-tdd-timeline"
    },
    {
      "id": "unknown-normalized-event-fails-closed",
      "events": [
        {"type": "fileMutation", "paths": ["test_feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 1, "failureClass": "expected-behavior-assertion", "timelineObservable": true},
        {"type": "futureOpaqueMutation", "paths": ["feature.py"], "timelineObservable": true},
        {"type": "fileMutation", "paths": ["feature.py"], "timelineObservable": true},
        {"type": "commandExecution", "focusedTestCommand": true, "exitCode": 0, "failureClass": null, "timelineObservable": true}
      ],
      "expectedStatus": "rejected-offline-tdd-timeline"
    }
  ],
  "claimBoundary": {
    "provesNormalizedOfflineClassifier": true,
    "provesRawAppServerItemNormalization": false,
    "provesLiveTimelineObservability": false,
    "provesTddTreatmentValue": false
  }
