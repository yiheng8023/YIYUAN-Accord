{
  "description": "Restore current Harness authority at native Claude Code session transitions.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/.runtime/UNMATERIALIZED/python\" -I -B \"${CLAUDE_PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 5,
            "statusMessage": "Restoring current Harness authority"
          }
        ]
      }
    ]
  }
}
