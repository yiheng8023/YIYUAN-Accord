{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python -I -B \"${PLUGIN_ROOT}/scripts/session_start.py\"",
            "commandWindows": "python -I -B \"${PLUGIN_ROOT}/scripts/session_start.py\"",
            "timeout": 15,
            "statusMessage": "Restoring current Harness authority",
            "additionalContextLimit": 4096
          }
        ]
      }
    ]
  }
}
