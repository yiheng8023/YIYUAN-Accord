    {
      "id": "increment.v11-terminal-authorization-trust-privacy",
      "state": "active",
      "correctionClass": "terminal-human-authorization-trust-and-public-privacy",
      "observedProblem": "The terminal candidate does not prebind the exact code-owned human-authorization validator or source trust policy, so a later public tag can choose a weaker registered validator after the candidate is fixed. The public tag annotation also accepts an arbitrary source locator, identity and unsalted payload digest, allowing local paths, credential targets, session identifiers or guessable private event material to be published while the gate remains structurally valid.",
      "hypothesis": "Binding the terminal validator kind, version, committed code locator, revision and digest plus a public-source policy in the candidate, requiring the tag to reuse that validator, and replacing public locator fields with a random public identity and keyed commitment will close post-candidate validator selection and private-source disclosure without implementing the final source validator early.",
      "falsifier": "Stop or revise if the repair prebuilds or selects the final terminal source validator, publishes a private locator or raw source identity, weakens named-human verification, adds a new acceptance threshold or human action, changes frozen cohort state, performs a release, creates outcome evidence, or produces any O1-O5 progress.",
      "stopCondition": "Stop after an unregistered binding remains null; every candidate prebinds one exact committed code-owned terminal validator and source policy before tag creation; tag annotations can contain only a random public identity and keyed commitment and must reuse the candidate validator; predecessor locator-bearing tags and validator mismatch fail closed; verifier and full product tests pass with O1-O5 at 0/5; residue is absent; and this outcome-neutral increment exits the graph.",
      "acceptanceIds": [
        "G1",
        "G2",
        "G3",
        "G4"
      ],
      "taskRegistration": null,
      "processLossBudget": {
        "maxSameClassUserCorrectionBeforeStop": 1,
        "maxConsecutiveOutcomeNeutralWorkItems": 1,
        "maxProhibitedAgentWorkTransfers": 0,
        "stopOnAuthorityOrIrreversibleIncident": true,
        "stopOnUnboundedResidue": true
      },
