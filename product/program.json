  "increments": [
    {
      "id": "increment.v11-registration-domain-alignment",
      "state": "active",
      "correctionClass": "current-cohort-registration-domain-alignment",
      "observedProblem": "The current frozen v1.1 cohort activation and protocol use the v1.1 source-message rule and HMAC domain, but the code-owned task-registration guard still compares enrollment and private-binding values with predecessor v1 constants. A legitimate first v1.1 registration would therefore fail while predecessor v1 values could pass, and fixture helpers currently reproduce the wrong domain.",
      "hypothesis": "Making registration validation derive the source-message rule and HMAC domain from the already-validated frozen activation, and making the current source-capture rule use the current protocol binding, will accept only the authorized v1.1 domain without hard-coding a future version or changing the frozen cohort.",
      "falsifier": "Stop or revise if the repair changes frozen profile or protocol bytes, restarts or reauthorizes the cohort, creates a natural task or result validator, weakens registration chronology or deduplication, accepts predecessor v1 values against the current activation, changes an outcome threshold, or produces any O1-O5 progress.",
      "stopCondition": "Stop after current v1.1 registration cohort values pass, predecessor v1 values fail against the current activation, the fixture route no longer masks the mismatch, canonical verifier and full product tests pass with O1-O5 at 0/5, all task-created residue is absent, and this outcome-neutral increment exits the current graph.",
      "acceptanceIds": [
        "G2",
        "G3",
        "G4"
      ],
      "taskRegistration": null,
      "processLossBudget": {
        "maxSameClassUserCorrectionBeforeStop": 1,
        "maxConsecutiveOutcomeNeutralWorkItems": 1,
        "maxProhibitedAgentWorkTransfers": 0,
        "stopOnAuthorityOrIrreversibleIncident": true,
        "stopOnUnboundedResidue": true
      },
